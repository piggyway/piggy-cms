# Database Configuration
DB_CLIENT=pg
DB_HOST=your-database-host
DB_PORT=5432
DB_DATABASE=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password

# Directus Configuration
SECRET=your-secret-key-change-this-in-production
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=admin123
DIRECTUS_PORT=8055

# Directus Sync Configuration (optional)
DIRECTUS_URL=http://localhost:8055
DIRECTUS_ADMIN_TOKEN=
DIRECTUS_SYNC_DUMP_PATH=/directus/directus-config

# Environment
ENV=DEV

# SSL Configuration for PostgreSQL (set to true for Neon, AWS RDS, etc.)
# For Neon/AWS RDS, use: DB_SSL={"rejectUnauthorized":false}
# For local PostgreSQL, use: DB_SSL=false
